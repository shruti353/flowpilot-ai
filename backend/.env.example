# FlowPilot AI - Week 1 backend configuration
# Copy this file to `.env` and adjust values as needed.

# --- Ollama LLM provider -----------------------------------------------
# Base URL of a running Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Model tag to use for planning. Must be pulled locally first:
#   ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# Request timeout (seconds) when calling Ollama. A 3B model on CPU
# typically answers in 15-30s; this leaves headroom for a cold model load
# or a busy machine before the API gives up and returns a 502.
OLLAMA_TIMEOUT_SECONDS=90

# --- Application ---------------------------------------------------------
APP_NAME=FlowPilot AI
API_V1_PREFIX=/api/v1

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call this API.
# Defaults cover the Vite dev server (frontend/). Add your deployed
# frontend origin here before pointing a production build at this API -
# do not widen this to "*" outside of local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
