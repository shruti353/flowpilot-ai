# FlowPilot AI - backend configuration
# Copy this file to `.env` and adjust values as needed.
# Never commit the real `.env` - only this example file with placeholders.

# --- Ollama LLM provider -----------------------------------------------
# Base URL of a running Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Model tag to use for planning. Must be pulled locally first:
#   ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# Request timeout (seconds) when calling Ollama. A 3B model on CPU
# typically answers in 15-30s; this leaves headroom for a cold model load
# or a busy machine before the API gives up and returns a 502.
OLLAMA_TIMEOUT_SECONDS=90

# --- Application ---------------------------------------------------------
APP_NAME=FlowPilot AI
API_V1_PREFIX=/api/v1

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call this API.
# Defaults cover the Vite dev server (frontend/). Add your deployed
# frontend origin here before pointing a production build at this API -
# do not widen this to "*" outside of local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Execution (Week 3) --------------------------------------------------
# IANA timezone used to resolve relative datetime expressions like
# "tomorrow at 3 PM" at execution time. This is deterministic application
# logic - the LLM is never asked what "today" is.
FLOWPILOT_TIMEZONE=Asia/Kolkata

# Calendar events created without an explicit end time last this long.
DEFAULT_EVENT_DURATION_MINUTES=60

# Where FastAPI sends the structured execution request for
# calendar.create_event. Set EITHER a full webhook URL...
N8N_CALENDAR_WEBHOOK_URL=http://localhost:5678/webhook/flowpilot-calendar
# ...OR a base URL + path (used only if the full URL above is unset):
# N8N_BASE_URL=http://localhost:5678
# N8N_CALENDAR_WEBHOOK_PATH=/webhook/flowpilot-calendar

# Timeout (seconds) for the FastAPI -> n8n HTTP call.
N8N_TIMEOUT_SECONDS=30

# SECURITY: Google OAuth client secrets, refresh tokens, and API keys are
# configured ONLY inside n8n's own credential store (see backend/README.md
# section "Google Calendar credentials"). They must never appear in this
# file, in any FastAPI environment variable, or anywhere the LLM prompt is
# built.
